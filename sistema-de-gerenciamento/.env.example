# Copie para .env (o .env NAO vai para o git) e preencha.

# Chave da API da Anthropic usada pelo chatbot do painel.
ANTHROPIC_API_KEY=

# Modelo e esforco do chatbot (Claude Haiku 5.5 por padrao).
CHATBOT_MODELO=claude-haiku-5-5
CHATBOT_ESFORCO=high

# Banco ficticio. Vazio = SQLite em app/database/bulbe_ficticio.db
BULBE_DB_URL=

# Segredo que assina os tokens do painel. Troque por um valor longo e aleatorio.
PAINEL_SECRET=troque-este-segredo

# Senha dos funcionarios de demonstracao criados pelo seed
# (admin@bulbe.com.br, atendimento@bulbe.com.br, ana.souza@bulbe.com.br).
PAINEL_SENHA_DEMO=bulbe@demo123

# Tempo maximo (segundos) de cada chamada do chatbot a API. Opcional.
CHATBOT_TIMEOUT=60

# Tamanho maximo de uma conversa (mensagens) guardada no servidor.
CHATBOT_MAX_MENSAGENS_CONVERSA=200

# Precos usados para estimar o custo do chatbot (USD por milhao de tokens, Claude Haiku 5.5).
CHATBOT_PRECO_ENTRADA_MTOK=0.10
CHATBOT_PRECO_SAIDA_MTOK=0.50
CHATBOT_FATOR_CACHE_LEITURA=0.1
CHATBOT_FATOR_CACHE_ESCRITA=1.25
CHATBOT_LIMITE_PROMPT_LONGO=100000
CHATBOT_PRECO_ENTRADA_LONGO_MTOK=0.50
CHATBOT_PRECO_SAIDA_LONGO_MTOK=2.50

# Retencao de dados (dias). O expurgo roda ao subir o servidor e pela rota de admin.
CHAT_RETENCAO_DIAS=180
AUDITORIA_RETENCAO_DIAS=730

# Seguranca do login
LOGIN_ALERTA_APOS_FALHAS=3
LOGIN_BLOQUEIO_APOS_FALHAS=5
LOGIN_JANELA_MINUTOS=15

# Alerta por e-mail quando alguem erra a senha mais de LOGIN_ALERTA_APOS_FALHAS vezes.
# Para Gmail: SMTP_HOST=smtp.gmail.com, porta 587 e uma "senha de app" (nao a senha normal da conta).
ALERTA_LOGIN_EMAIL=seu-email@exemplo.com
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_TLS=true
