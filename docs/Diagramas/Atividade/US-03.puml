@startuml
title US-03 — Listar cupons do cliente (GET /v1/clientes/{id}/cupons)

start
:Receber id do cliente e filtros;
:Buscar cliente no banco;

if (Cliente existe?) then (sim)
  fork
    :Consultar cupons do cliente;
  fork again
    :Verificar validade dos cupons;
  end fork
  if (Existe cupom vencido?) then (sim)
    :Atualizar situação para "expirado";
  else (não)
    :Manter situação atual dos cupons;
  endif
  :Retornar 200 OK\ncom a lista de cupons;
else (não)
  :Retornar 404 Not Found;
endif

stop
@enduml
