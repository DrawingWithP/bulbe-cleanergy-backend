@startuml
title US-05 — Buscar dados de um cliente (GET /v1/clientes/{id})

start
:Receber id do cliente;
:Validar formato do identificador;

if (Id em formato válido?) then (sim)
  :Consultar cliente no banco;
  if (Cliente existe?) then (sim)
    fork
      :Mascarar CPF e telefone;
    fork again
      :Carregar endereço e\ncódigo de indicação;
    end fork
    :Retornar 200 OK\ncom os dados do cliente;
  else (não)
    :Retornar 404 Not Found;
  endif
else (não)
  :Retornar 400 Bad Request;
endif

stop
@enduml
