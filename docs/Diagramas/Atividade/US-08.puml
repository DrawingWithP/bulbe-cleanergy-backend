@startuml
title US-08 — Cancelar uma adesão em andamento (DELETE /v1/adesoes/{id})

start
:Receber id da adesão a cancelar;
:Buscar adesão no banco;

if (Adesão existe?) then (sim)
  if (Adesão já aprovada?) then (não)
    :Marcar adesão como cancelada;
    fork
      :Registrar log de auditoria;
    fork again
      :Liberar número de instalação\npara nova adesão;
    end fork
    :Retornar 204 No Content;
  else (sim)
    :Retornar 409 Conflict\n(cancelamento não permitido aqui);
  endif
else (não)
  :Retornar 404 Not Found;
endif

stop
@enduml
