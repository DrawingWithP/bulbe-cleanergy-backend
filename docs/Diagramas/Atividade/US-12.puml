@startuml
title US-12 — Atualizar etapas da ativação (PATCH /v1/clientes/{id}/ativacao)

start
:Receber id do cliente e nova etapa;
:Validar intervalo da etapa (1 a 5);

if (Etapa dentro do intervalo?) then (sim)
  :Buscar cliente no banco;
  if (Cliente existe?) then (sim)
    :Atualizar etapa atual da ativação;
    fork
      :Recalcular percentual concluído;
    fork again
      :Recalcular prazo estimado;
    fork again
      :Notificar cliente sobre o avanço;
    end fork
    :Retornar 200 OK\ncom a ativação atualizada;
  else (não)
    :Retornar 404 Not Found;
  endif
else (não)
  :Retornar 400 Bad Request;
endif

stop
@enduml
