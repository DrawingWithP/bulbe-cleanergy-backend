@startuml
title US-14 — Listar indicações do cliente (GET /v1/clientes/{id}/indicacoes)

participant "Cliente\n(App Bulbe)" as Cliente
participant "API\n(Bulbe Energia)" as API
database "Banco de\nDados" as DB

Cliente -> API : GET /v1/clientes/{id}/indicacoes?situacao&page&limit
activate API

API -> DB : SELECT cliente WHERE id = ?
DB --> API : cliente

alt cliente não encontrado
  API --> Cliente : 404 Not Found
else cliente encontrado
  par indicações
    API -> DB : SELECT indicacoes WHERE cliente_id = ?\nAND filtros LIMIT/OFFSET
    DB --> API : lista de indicações
  else bônus acumulado
    API -> DB : SELECT SUM(bonus) WHERE situacao = 'aderiu'
    DB --> API : bônus acumulado
  end
  API --> Cliente : 200 OK {data, bonus_acumulado, page, total}
end
deactivate API
@enduml
